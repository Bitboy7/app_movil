# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ───────────────────────────────────────────────
# ARCHIVOS SENSIBLES — NO SUBIR AL REPOSITORIO
# ───────────────────────────────────────────────

# Firebase — contienen API keys y configuración privada
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Variables de entorno y secretos
.env
.env.*
*.env
secrets.dart
secrets.json

# Android — firma y claves del keystore
android/key.properties
**/*.keystore
**/*.jks

# Android — rutas locales del SDK (ya en android/.gitignore, refuerzo aquí)
android/local.properties

# iOS — archivos de exportación con credenciales
ios/ExportOptions.plist

# OpenCode — config local que puede contener tokens
.opencode/

# Archivos de configuración local del desarrollador
*.local.dart
*.local.json
